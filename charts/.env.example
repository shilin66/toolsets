# API 密钥配置
CHART_API_KEY=default-secret-key

# 存储类型配置: local、minio 或 custom
STORAGE_TYPE=local

# ===== MinIO 配置 (当 STORAGE_TYPE=minio 时需要配置) =====
# MinIO 服务地址 (不包含 http/https)
MINIO_ENDPOINT=localhost:9000

# MinIO 访问凭证
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key

# MinIO Bucket 名称
MINIO_BUCKET=charts

# 是否使用 HTTPS 连接 MinIO
MINIO_SECURE=false

# 可选: 自定义公网访问地址 (如使用 CDN 或反向代理)
# 留空则使用 MINIO_ENDPOINT 生成链接
# 示例: https://cdn.example.com 或 https://minio.example.com
MINIO_PUBLIC_URL=

# ===== 自定义上传接口配置 (当 STORAGE_TYPE=custom 时需要配置) =====
# 上传接口地址
CUSTOM_UPLOAD_URL=https://api.fashion-tele.com/oss/upload

# 表单中的 bucket 字段
CUSTOM_UPLOAD_BUCKET=itsm/attachments

# 上传接口鉴权
CUSTOM_UPLOAD_ACCESS_KEY=your-access-key
CUSTOM_UPLOAD_SECRET_KEY=your-secret-key

# 可选: 自定义鉴权请求头名称
CUSTOM_UPLOAD_ACCESS_KEY_HEADER=X-Access-Key
CUSTOM_UPLOAD_SECRET_KEY_HEADER=X-Secret-Key

# 可选: 上传超时时间(秒)
CUSTOM_UPLOAD_TIMEOUT=30

# 下载远程文件超时时间(秒)
FILE_FETCH_TIMEOUT=30

# 相对路径下载时使用的基础地址
# 例如: https://static.example.com
SOURCE_FILE_BASE_URL=
