# 邮箱配置（可选）
# 邮箱账号已支持在管理台「邮箱配置」页面维护（多邮箱）。
# 以下配置仅在首次启动且数据库无账号时自动迁移为默认账号，之后以数据库为准。
IMAP_SERVER=
IMAP_PORT=
IMAP_USE_SSL=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
# 邮箱密码加密密钥（可选）：合法 Fernet 密钥；不配置则自动生成并保存到 data/mail_secret.key
MAIL_SECRET_KEY=
# API配置
API_URL=
API_TOKEN=
API_PORT=5001
FE_DOMAIN=
API_PUBLIC_BASE_URL=
API_TIMEOUT=600

# 检查邮件间隔（秒）
CHECK_INTERVAL=30
# 是否标记已读
MARK_AS_READ=false
# 邮件过滤时间（小时）
EMAIL_HOURS_FILTER=3
# 邮箱服务器是否支持IDLE模式
IMAP_IDLE_SUPPORT=true
# IDLE模式超时时间（秒），建议30分钟
IDLE_TIMEOUT=1200
# IDLE连接断开后重连延迟（秒）
IDLE_RECONNECT_DELAY=5
# 每批处理的最大邮件数量
MAX_EMAILS_PER_BATCH=50
# 搜索操作超时时间（秒）
SEARCH_TIMEOUT=30

# 并发配置
# 是否启用并发处理
CONCURRENT_PROCESSING=true
# 最大并发处理邮件数量
MAX_CONCURRENT_EMAILS=10

# 日志配置
LOG_LEVEL=DEBUG

# API Key 配置
API_KEY=

# 集团综合调度系统 RPA 登录
RPA_LOGIN_URL=https://ofm.crm.189.cn:23122/portal/?ignoreDisableDevtool=true#/pLogin
RPA_MOBILE_LOGIN_URL=https://ofm.crm.189.cn:23122/portal/?ignoreDisableDevtool=true#/login
RPA_SESSION_CHECK_URL=https://ofm.crm.189.cn:23122/portal/?ignoreDisableDevtool=true#/
# 管理台“综调会话”使用以下双环境地址；生产地址未配置时页面会明确显示不可用。
RPA_DEFAULT_ENVIRONMENT=test
RPA_TEST_LOGIN_URL=https://ofm.crm.189.cn:23122/portal/?ignoreDisableDevtool=true#/pLogin
RPA_TEST_MOBILE_LOGIN_URL=https://ofm.crm.189.cn:23122/portal/?ignoreDisableDevtool=true#/login
RPA_TEST_SESSION_CHECK_URL=https://ofm.crm.189.cn:23122/portal/?ignoreDisableDevtool=true#/
RPA_PRODUCTION_LOGIN_URL=
RPA_PRODUCTION_MOBILE_LOGIN_URL=
RPA_PRODUCTION_SESSION_CHECK_URL=
RPA_USERNAME=
RPA_PASSWORD=
RPA_HEADLESS=true
RPA_IGNORE_HTTPS_ERRORS=false
RPA_TIMEOUT_MS=30000
RPA_SLOW_MO_MS=0
RPA_REPORT_ACTION_DELAY_MS=800
RPA_VIEWPORT_WIDTH=1920
RPA_VIEWPORT_HEIGHT=1080
RPA_ATTEMPT_TTL_SECONDS=300
RPA_CAPTCHA_REFRESH_WAIT_MS=500
# 登录成功后，服务端在隔离浏览器上下文中定期刷新会话并保存最新 Cookie。
RPA_SESSION_KEEPALIVE_ENABLED=true
RPA_SESSION_KEEPALIVE_INTERVAL_SECONDS=600
# 默认值已匹配截图中的中文 placeholder；实际 DOM 不同时再覆盖。
RPA_USERNAME_SELECTOR=input[placeholder="请输入用户名"]
RPA_PASSWORD_SELECTOR=input[placeholder="请输入密码"]
RPA_CAPTCHA_INPUT_SELECTOR=input[placeholder="请输入验证码"]
# 只截取该元素用于识别；实际 DOM 不同时覆盖此选择器。
RPA_CAPTCHA_IMAGE_SELECTOR=xpath=//*[@placeholder="请输入验证码"]/following::img[1]
# multimodal：远程多模态模型；ocr：本地 RapidOCR，不访问外部接口。
RPA_CAPTCHA_RECOGNIZER=multimodal
RPA_SUBMIT_SELECTOR=button:has-text("登录")
RPA_MOBILE_PHONE_SELECTOR=input[placeholder="手机号"]
RPA_MOBILE_PASSWORD_SELECTOR=input[placeholder="密码"]
RPA_MOBILE_CAPTCHA_INPUT_SELECTOR=input[placeholder="图形验证码"]
RPA_MOBILE_CAPTCHA_IMAGE_SELECTOR=xpath=//*[@placeholder="图形验证码"]/following::img[1]
RPA_MOBILE_SMS_INPUT_SELECTOR=input[placeholder="验证码"]
RPA_MOBILE_SMS_BUTTON_SELECTOR=text=获取验证码
RPA_MOBILE_SUBMIT_SELECTOR=button:has-text("登录")
# 可选；配置后以 URL 匹配结果作为登录成功条件，例如 **/index
RPA_SUCCESS_URL_PATTERN=
# 登录后必须出现该控件才判定成功，避免把反调试拦截页误判成首页。
RPA_POST_LOGIN_READY_SELECTOR=text=工单处理
RPA_STATE_PATH=data/rpa/auth-state.json
RPA_TEST_STATE_PATH=data/rpa/auth-state-test.json
RPA_PRODUCTION_STATE_PATH=data/rpa/auth-state-production.json
RPA_ARTIFACT_DIR=data/rpa/artifacts
RPA_SUCCESS_SCREENSHOT_PATH=data/rpa/artifacts/login-success.png

# 客户线路割接 Excel 上报（直达割接影响页面后的控件）
RPA_REPORT_EXCEL_IMPORT_SELECTOR=text=EXCEL导入
RPA_REPORT_DIALOG_SELECTOR=text=传输任务及影响电路导入
RPA_REPORT_FILE_INPUT_SELECTOR=input[type="file"]
RPA_REPORT_SUBMIT_SELECTOR=button:has-text("提交")
# 可选；不配置时以导入弹窗关闭或常见成功提示作为成功条件。
RPA_REPORT_SUCCESS_SELECTOR=
# 骨干线路表单上报（直达“传输一干”页面后的控件）
RPA_REPORT_BACKBONE_READY_SELECTOR=text=传输一干
RPA_REPORT_BACKBONE_SUBMIT_SELECTOR=button:has-text("提交")
RPA_REPORT_BACKBONE_ATTACHMENT_SELECTOR=input[type="file"]
RPA_REPORT_BACKBONE_SUCCESS_SELECTOR=text=提交成功

# OpenAI-compatible 多模态验证码识别
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=replace-with-your-api-key
OPENAI_COMPATIBLE_MODEL=replace-with-your-vision-model
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=120
